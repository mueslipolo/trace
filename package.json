{
  "name": "trace-diagrams",
  "version": "0.1.0",
  "description": "Trace: write diagrams as plain text, get them drawn like a careful hand would.",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/trace.js",
  "scripts": {
    "render": "node tools/render.js",
