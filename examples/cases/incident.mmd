flowchart TD
    alert["Alert fires: SLO burn rate"] --> real{actionable?}
    real -->|no| tune["Tune or silence the alert"]
    real -->|yes| sev{customer impact?}
    sev -->|none| sev3["SEV-3: fix in business hours"]
    sev -->|yes| page["Page on-call: PagerDuty, 5 min ack"]
    page --> ack{acknowledged?}
    ack -->|no| escalate["Escalate: secondary, then manager"]
    escalate --> ic
    ack -->|yes| ic["Declare incident: commander, Slack channel"]
    ic -.-> status["Status page: every 30 min"]
    ic --> mitigate["Mitigate: rollback, failover, flag"]
    mitigate --> fixed{impact over?}
    fixed -->|no, next option| mitigate
    fixed -->|yes| review["Postmortem: within 5 days, blameless"]