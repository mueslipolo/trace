title "Order processing on Kafka"

checkout [api]: Checkout API

frame orders "order service" [blue] {
  store odb [database]: orders DB | with outbox table
  relay [arrow-right-left]: Outbox relay | Debezium
}

frame kafka "Kafka" [grey] {
  column "topics" {
    store tOrders [queue]: orders.created
    store tPay [queue]: payments.settled
    store tShip [queue]: shipments.updated
  }
}

column "consumers" {
  payment [credit-card]: Payment service
  inventory [package]: Inventory service
  shipping [truck]: Shipping service
  notify [bell]: Notification service
}

column {
  engine psp [landmark]: Payment provider
  store dlq [bad trash-2]: Dead-letter topic
}

checkout -> odb : one transaction
odb -> relay : change stream
relay -> tOrders
tOrders -> payment
tOrders -> inventory
tOrders -> notify
tPay <- payment : publishes
tPay -> shipping : ship when paid
tShip <- shipping : publishes
tShip -> notify
payment -> psp
payment -> dlq [bad] : after 5 retries
