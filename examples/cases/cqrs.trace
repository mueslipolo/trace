title "CQRS with event sourcing"

client [user]: Client
frame write "write side" [blue] {
  cmd [terminal]: Command API
  agg [box]: Order aggregate | validates rules
  store events [database]: Event store | append only
}
bus [arrow-right-left]: Event bus
frame read "read side" [green] {
  proj [wand-sparkles]: Projector
  store view [database]: Read model | denormalised
  query [search]: Query API
}
frame side "side effects" [purple] {
  mail [mail]: Email sender
  search [search]: Search indexer
  bill [credit-card]: Invoicing
}

client -> cmd : place order
cmd -> agg
agg -> events : append OrderPlaced
events -> bus : publish
bus -> proj
proj -> view : update
client <- query : orders
query -> view : read
bus -> mail
bus -> search
bus -> bill
agg <- events [dashed] : rebuild state
