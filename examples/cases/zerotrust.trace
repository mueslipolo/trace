title "Zero-trust access to internal apps"

column "users" {
  pill emp [laptop]: Employee laptop | managed device
  pill contractor [user]: Contractor | browser only
}

frame edge "access edge" [orange] {
  proxy [shield]: Identity-aware proxy | per-request policy
}

frame idp "identity" [purple] {
  row {
    sso [key]: SSO / IdP | SAML, OIDC
    mfa [mobile]: MFA | WebAuthn
  }
  posture [monitor]: Device posture | MDM signals
}

frame private "private network, no inbound ports" [blue] {
  connector [bridge span cable]: App connector | dials out to the edge
  column "apps" {
    wiki [document]: Wiki
    git [git-branch]: Git server
    admin [bad settings]: Admin console
  }
}

vpn [dashed vpn]: Legacy VPN | being retired

emp -> proxy : 443/tcp mTLS
contractor -> proxy : 443/tcp
proxy -> sso : 443 SAML/OIDC redirect
sso -> mfa : 443 WebAuthn
proxy <- posture [muted] : 443 device health
proxy -> connector : 443 over the tunnel
connector -> wiki : 443/tcp
connector -> git : 22/tcp, 443/tcp
connector -> admin [bad] : 8443/tcp admins only
emp --> vpn : IPsec UDP 500/4500, until Q3
vpn --> git : 22/tcp

key -> [bad] : restricted
key box [dashed] : being retired
