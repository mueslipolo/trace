title "Hybrid cloud: datacenter to AWS"

frame dc "on-prem datacenter" [grey] {
  ad: Active Directory
  erp: ERP | Oracle
  core: Core switch
  dcfw: Datacenter firewall | IPsec peer
}

pill users: Internet users
frame aws "AWS eu-west-1" [orange] {
  tgw: Transit gateway
  frame vpc "VPC 10.20.0.0/16" [blue] {
    frame pub "public subnets" [green] {
      igw: Internet gateway
      alb: Application load balancer
    }
    frame priv "private subnets" [green] {
      app1: app ASG | az-a
      app2: app ASG | az-b
      nat: NAT gateway
    }
    frame dbs "database subnets" [purple] {
      store rds: RDS primary
      store rdss: RDS standby
    }
  }
}
pill internet: Internet | egress

ad -> core : 389, 636 LDAP(S)
erp -> core : 1521/tcp
core -> dcfw : 802.1Q trunk
dcfw -> tgw : BGP 179, Direct Connect 10 Gb
dcfw --> tgw : IPsec UDP 500/4500, backup
users -> igw : 443/tcp
igw -> alb : 443/tcp
alb -> app1 : 8080/tcp
alb -> app2 : 8080/tcp
app1 -> rds : 5432/tcp
app2 -> rds : 5432/tcp
rds -> rdss : 5432, sync replication
app1 -> tgw [muted] : LDAPS 636 to AD
app1 -> nat : any/tcp
app2 -> nat : any/tcp
nat -> internet : 443/tcp egress
