app-admin -> ui
app-admin -> forms
app-admin -> charts
app-admin -> api
ui -> utils
ui -> types
forms -> ui
forms -> utils
charts -> utils
charts -> types
auth -> api
auth -> logger
api -> http
api -> types
http -> logger
http -> config
logger -> config
