direction down
title "Web stack in one VPC across two zones"

pill users [user]: Users
cdn [cloud]: CDN | static assets, TLS
alb [loadbalancer]: Application load balancer

frame vpc "VPC 10.0.0.0/16" [grey] {
  row {
    frame az1 "zone a" [blue] {
      web1 [server]: Web a | autoscaling group
      app1 [container]: App a | ECS tasks
      store db1 [database]: Postgres primary
    }
    column {
      store cache [cache]: Redis cluster | sessions
      nat [arrow-right-left]: NAT gateway
    }
    frame az2 "zone b" [blue] {
      web2 [server]: Web b | autoscaling group
      app2 [container]: App b | ECS tasks
      store db2 [database]: Postgres standby
    }
  }
}
store s3 [package]: S3 | uploads, backups
ext [cloud]: Payment API

users -> cdn : 443/tcp
cdn -> alb : 443/tcp
alb -> web1 : 8080/tcp
alb -> web2 : 8080/tcp
web1 -> app1
web2 -> app2
app1 -> db1 : 5432/tcp
app2 -> db2 : 5432/tcp
db1 -> db2 [dashed] : replication
app1 -> cache : 6379/tcp
app2 -> cache : 6379/tcp
app1 -> s3 : 443/tcp
app2 -> s3 : 443/tcp
app1 -> nat
app2 -> nat
nat -> ext : 443/tcp
