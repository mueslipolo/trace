flowchart LR
    users([Internet users]) --> ddos[DDoS scrubbing]
    partners([Partner APIs]) --> ddos
    subgraph edge[edge, provider managed]
        ddos --> cdn["CDN + WAF: TLS termination, bot rules"]
    end
    cdn -->|443| fw1{{"Edge firewall: stateful, geo-block"}}
    subgraph dmz["DMZ, 10.0.1.0/24"]
        lb["Load balancer pair: VRRP, health checks"]
        rp["Reverse proxy: nginx, mTLS to partners"]
        bastion["Bastion host: SSH via SSO only"]
    end
    fw1 --> lb
    fw1 -->|mTLS| rp
    fw1 -.->|SSH, VPN users only| bastion
    lb --> fw2{{"Internal firewall: allow 443, 8443 only"}}
    rp --> fw2
    subgraph app["app zone, 10.0.2.0/24"]
        web1[web-01]
        web2[web-02]
        api1[api-01]
    end
    fw2 --> web1
    fw2 --> web2
    fw2 --> api1
    web1 --> fw3{{"DB firewall: 5432, 6379 from app only"}}
    web2 --> fw3
    api1 --> fw3
    subgraph data["data zone, 10.0.3.0/24"]
        pgp[(Postgres primary)]
        pgr[(Postgres replica)]
        redis[("Redis: sessions, cache")]
    end
    fw3 --> pgp
    fw3 --> redis
    pgp -->|streaming replication| pgr
    subgraph mgmt[management VLAN]
        siem[SIEM]
    end
    fw1 -.-> siem
    fw2 -.-> siem
    fw3 -.-> siem