direction down
frame dmz "DMZ" [orange] {
  fw1 [bridge span firewall]: Edge firewall
  row {
    lb: Load balancer
    rp: Reverse proxy
  }
}
frame app "app zone" [blue] {
  fw2 [bridge span firewall]: Internal firewall
  row {
    web: Web servers
    api: API servers
  }
}
fw1 -> lb
fw1 -> rp
lb -> fw2
rp -> fw2
fw2 -> web
fw2 -> api
