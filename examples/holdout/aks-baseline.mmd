%% Written for comparison from the same nodes and links as aks-baseline.trace
flowchart TD
  subgraph hub[Hub VNet]
    subgraph fwsnet[Subnet]
      fw["Azure Firewall<br/>outbound"]
    end
    subgraph bastionsnet[Subnet]
      bastion["Azure Bastion<br/>management"]
    end
    subgraph gwsnet[Subnet]
      gw["Gateway<br/>to on-premises"]
    end
  end
  onprem["On-premises<br/>placeholder"]
  spoke2["Spoke<br/>another business unit"]
  subgraph spoke[Spoke VNet]
    subgraph pesnet[Subnet]
      pe["Private Link<br/>endpoints"]
    end
    subgraph ilbsnet[Subnet]
      ilb["Internal Load Balancer<br/>AKS-managed"]
    end
    subgraph appgwsnet[Subnet]
      appgw["Azure Application Gateway<br/>WAF"]
    end
    subgraph nodes["Subnet: cluster nodes"]
      subgraph syspool[Node pool]
        sysnodes["Kubernetes system nodes"]
      end
      subgraph userpool[Node pool]
        usernodes["Kubernetes user nodes"]
        workload["Workload<br/>pod(s)"]
      end
    end
  end
  subgraph paas[" "]
    kv["Azure Key Vault"]
    acr[("Azure Container Registry")]
  end
  internet(["Public internet"])
  hub <-->|VNet peering| spoke
  spoke2 -->|VNet peered| hub
  gw --- onprem
  paas --> pesnet
  internet --> appgw
