# Full-feature version of ../proxmox-homelab-vlans.trace: the same nodes, links and labels, written with Trace's layout features. Not part of the held-out measure.
title "Two-node Proxmox homelab: VLANs"
direction down

pill NET [internet]: Internet / WAN
row {
  CF [cloud cloudflare]: Cloudflare Tunnel | inbound HTTPS · zero open ports
  TS [vpn tailscale]: Tailscale | remote admin · subnet-router
}
engine FW [firewall opnsense]: OPNsense | router · firewall deny-by-default between VLANs
frame MGMT "Management VLAN" [purple] {
  column {
    N1 [server proxmox]: pve-infra node
    N2 [server proxmox]: pve-apps node
    PBS [hard-drive]: Proxmox Backup Server
  }
}
frame INFRA "Infra VLAN" [blue] {
  column {
    DNS [dns]: AdGuard DNS + OPNsense Unbound
    RP [arrow-right-left]: Caddy reverse proxy
    MON [chart]: Prometheus · Grafana · Uptime Kuma
  }
  column {
    IAC [settings]: Semaphore · Ansible · gh-runner
    TOOLS [key]: Vaultwarden · Twenty CRM · Umami
    AI [bot]: Hermes AI agent
  }
}
frame PROD "Production VLAN" [green] {
  column {
    PA [container]: Coolify worker (apps)
    store PDB [database]: dedicated project database VMs
  }
}
frame DEV "Dev / Staging VLAN · reserved" [grey] {
  CO: No dedicated guest currently deployed
}
frame MEDIA "Media & Personal VLAN" [orange] {
  DK [docker]: Docker VM | Jellyfin · Immich · Navidrome …
}

NET -> CF
CF -> FW
NET <-> TS
TS -> FW
FW <-> MGMT : admin plane · reaches all
FW <-> INFRA : ingress + observability
FW -> PROD : allow-listed ingress · WAN egress
FW -> DEV : tunnel ingress in · WAN out only
FW -> MEDIA : WAN out only
NET <- PROD : egress
NET <- DEV : egress
NET <- MEDIA : egress
