# Full-feature version of ../aks-baseline-network.trace: the same nodes, links and labels, written with Trace's layout features. Not part of the held-out measure.
# Adapted from the AKS baseline cluster reference implementation (github.com/mspnp/aks-baseline), docs/architecture.drawio, page "aks-baseline_details", its two networking resource groups (MIT)
title "AKS baseline: hub and spoke networking resources"

pill internet [globe]: Public Internet

frame hubrg "rg-enterprise-networking-hubs" [grey] {
  frame fwpips "three geo-redundant public IP addresses" [grey dashed] {
    column {
      pipfw0 [globe]: pip-fw-[region]-00
      pipfw1 [globe]: pip-fw-[region]-01
      pipfw2 [globe]: pip-fw-[region]-02
    }
  }
  fw [firewall]: fw-[region]
  frame fwpolicy " " [grey dashed] {
    column {
      fwpol [list-checks]: fw-policies-[region]
      ipg [list]: ipg-[region]-AksNodepools | 10.240.0.0/22
    }
  }
  nsgbastion [shield]: nsg-[region]-bastion
  frame hubvnet "vnet-[region]-hub, 10.200.0.0/24" [blue] {
    column {
      fwsubnet: AzureFirewallSubnet
      gwsubnet: GatewaySubnet
      bastionsubnet: AzureBastionSubnet
    }
  }
  store lahub [chart-line]: la-hub-[region]
}

frame spokerg "rg-enterprise-networking-spokes" [grey] {
  pipbu [globe]: pip-BU0001A0008-00
  frame nsgs " " [grey dashed] {
    column {
      nsgappgw [shield]: nsg-vnet-...-appgw | Internet > Vnet via tcp/443: Allow; [Azure Probes,...] > Vnet: Allow (and more)
      nsgpe [shield]: nsg-vnet-...-privatelinkendpoints | VNet > VNet via tcp/443: Allow (rest: deny)
      nsgilbs [shield]: nsg-vnet-...-aksilbs
      nsgnodes [shield]: nsg-vnet-...-nodepools
    }
  }
  route [route]: route-to-[region]-hub-fw | 0.0.0.0/0 > fw-region's private IP
  frame spokevnet "vnet-spoke-BU0001A0008-00, 10.240.0.0/16" [blue] {
    column {
      appgwsubnet: snet-applicationgateway | 10.240.5.0/24
      pesubnet: snet-privatelinkendpoints | 10.240.4.32/28
      ingresssubnet: snet-clusteringressservices | 10.240.4.0/28
      nodesubnet: snet-clusternodes | 10.240.0.0/22
    }
  }
}

fwpips -> internet : outbound traffic to internet
fw -> fwsubnet : connects to subnet
fw -> fwpips : uses public IP addresses
internet -> pipbu : inbound requests (from internet)
fw -> fwpol : implements rule set
fwpol -> ipg : uses IP group
fw -> lahub : sends logs, metrics
hubvnet -> lahub : sends logs, metrics
fwpol -> lahub
pipbu -> lahub
nsgs -> lahub
lahub -- nsgbastion
fwpips -- lahub
spokevnet <-> hubvnet : peered with
nsgbastion -> bastionsubnet : filters traffic
nsgappgw -> appgwsubnet : filters traffic
nsgpe -> pesubnet : filters traffic
nsgilbs -> ingresssubnet : filters traffic
nsgnodes -> nodesubnet : filters traffic
route -> nodesubnet : directs outbound traffic
route -> ingresssubnet

mark lahub "sends logs, metrics to la-hub-[region]"
