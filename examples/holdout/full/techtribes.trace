# Full-feature version of ../techtribes.trace: the same nodes, links and labels, written with Trace's layout features. Not part of the held-out measure.
# Adapted from C4-PlantUML, samples/C4_Container Diagram Sample - techtribesjs.puml (MIT)
direction down
title "Containers: techtribes.js"

row {
  pill anon [user]: Anonymous User
  pill aggregated [user]: Aggregated User
  pill admin [user]: Administration User
}

frame c1 "techtribes.js" [blue] {
  web [span server]: Web Application | Java, Spring MVC, Tomcat 7
  row {
    store reldb [database mysql]: Relational Database | MySQL 5.5
    store fs [folder]: File System | search indexes
    store nosql [database mongodb]: NoSQL Data Store | MongoDB 2.2
  }
  updater [span clock]: Updater | Java 7 console app
}

row {
  engine twitter [bird]: Twitter
  engine github [github]: GitHub
  engine blogs [rss]: Blogs
}

anon -> web : uses, HTTPS
aggregated -> web : uses, HTTPS
admin -> web : uses, HTTPS
web -> reldb : reads and writes, SQL/JDBC 3306
web -> fs : reads from
web -> nosql : reads from, MongoDB 27017
reldb <- updater : reads and writes, SQL/JDBC 3306
fs <- updater : writes to
nosql <- updater : reads and writes, MongoDB 27017
updater -> twitter : profiles and tweets, HTTPS
updater -> github : public repositories, HTTPS
updater -> blogs : RSS and Atom feeds, HTTP
