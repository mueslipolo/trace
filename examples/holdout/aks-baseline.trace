# Adapted from the AKS baseline cluster reference implementation (github.com/mspnp/aks-baseline), docs/architecture.drawio, page "aks-baseline" (MIT)
direction down
title "AKS baseline: hub and spoke"

frame hub "Hub VNet" [grey dashed] {
  frame fwsnet "Subnet" [blue] {
    fw [firewall]: Azure Firewall | outbound
  }
  frame bastionsnet "Subnet" [blue] {
    bastion [terminal]: Azure Bastion | management
  }
  frame gwsnet "Subnet" [blue] {
    gw [vpn]: Gateway | to on-premises
  }
}
engine onprem [dashed building-2]: On-premises | placeholder
engine spoke2 [dashed network]: Spoke | another business unit

frame spoke "Spoke VNet" [grey dashed] {
  frame pesnet "Subnet" [blue] {
    pe [lock]: Private Link | endpoints
  }
  frame ilbsnet "Subnet" [blue] {
    ilb [loadbalancer]: Internal Load Balancer | AKS-managed
  }
  frame appgwsnet "Subnet" [blue] {
    appgw [shield]: Azure Application Gateway | WAF
  }
  frame nodes "Subnet: cluster nodes" [blue] {
    frame syspool "Node pool" [grey] {
      sysnodes [server]: Kubernetes system nodes
    }
    frame userpool "Node pool" [grey] {
      usernodes [server]: Kubernetes user nodes
      workload [container]: Workload | pod(s)
    }
  }
}
frame paas "" [blue] {
  kv [key]: Azure Key Vault
  store acr [container]: Azure Container Registry
}
pill internet [globe]: Public internet

hub <-> spoke : VNet peering
spoke2 -> hub : VNet peered
gw -- onprem
paas -> pesnet
internet -> appgw
