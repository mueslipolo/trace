title "Orders data model"

table customers "Customers" {
  id uuid pk
  email text unique
  name text
  deleted_at timestamptz null
}

table orders "Orders" {
  id uuid pk
  customer_id uuid fk
  placed_at timestamptz
  status text
  total numeric(10,2)
}

table order_items "Order items" {
  order_id uuid pk fk
  line int pk
  product_id uuid fk
  qty int
  unit_price numeric(10,2)
}

table products "Products" {
  id uuid pk
  sku text unique
  name text
  price numeric(10,2)
}

table payments "Payments" {
  id uuid pk
  order_id uuid fk
  amount numeric(10,2)
  provider_ref text null
}

orders.customer_id -> customers.id [n-1] : placed by
order_items.order_id -> orders.id [n-1] : part of
order_items.product_id -> products.id [n-1] : sells
payments.order_id -> orders.id [0n-1] : pays for
audit_log --> orders.id : refers to, no foreign key
